;s:9:\"tuan-chau\";s:7:\"to_ping\";s:0:\"\";s:6:\"pinged\";s:0:\"\";s:13:\"post_modified\";s:19:\"2014-05-29 15:53:37\";s:17:\"post_modified_gmt\";s:19:\"2014-05-29 15:53:37\";s:21:\"post_content_filtered\";s:0:\"\";s:11:\"post_parent\";i:0;s:4:\"guid\";s:71:\"http://localhost/wp-cms/vietaustravel.au/?post_type=location&#038;p=580\";s:10:\"menu_order\";i:0;s:9:\"post_type\";s:8:\"location\";s:14:\"post_mime_type\";s:0:\"\";s:13:\"comment_count\";s:1:\"0\";s:6:\"filter\";s:3:\"raw\";}i:4;O:7:\"WP_Post\":24:{s:2:\"ID\";i:579;s:11:\"post_author\";s:1:\"1\";s:9:\"post_date\";s:19:\"2014-05-29 15:53:09\";s:13:\"post_date_gmt\";s:19:\"2014-05-29 15:53:09\";s:12:\"post_content\";s:13:\"Hạ Long Bay\";s:10:\"post_title\";s:10:\"HALONG BAY\";s:12:\"post_excerpt\";s:0:\"\";s:11:\"post_status\";s:7:\"publish\";s:14:\"comment_status\";s:6:\"closed\";s:11:\"ping_status\";s:6:\"closed\";s:13:\"post_password\";s:0:\"\";s:9:\"post_name\";s:10:\"halong-bay\";s:7:\"to_ping\";s:0:\"\";s:6:\"pinged\";s:0:\"\";s:13:\"post_modified\";s:19:\"2014-05-29 15:53:09\";s:17:\"post_modified_gmt\";s:19:\"2014-05-29 15:53:09\";s:21:\"post_content_filtered\";s:0:\"\";s:11:\"post_parent\";i:0;s:4:\"guid\";s:71:\"http://localhost/wp-cms/vietaustravel.au/?post_type=location&#038;p=579\";s:10:\"menu_order\";i:0;s:9:\"post_type\";s:8:\"location\";s:14:\"post_mime_type\";s:0:\"\";s:13:\"comment_count\";s:1:\"0\";s:6:\"filter\";s:3:\"raw\";}i:5;O:7:\"WP_Post\":24:{s:2:\"ID\";i:536;s:11:\"post_author\";s:1:\"1\";s:9:\"post_date\";s:19:\"2014-05-21 14:52:58\";s:13:\"post_date_gmt\";s:19:\"2014-05-21 14:52:58\";s:12:\"post_content\";s:2825:\"<b style=\"color: #252525;\">Đồng Hới</b><span style=\"color: #252525;\">, tên cổ là </span><b style=\"color: #252525;\">Động Hải<span style=\"font-size: 11px;\"> </span></b><span style=\"color: #252525;\">, là </span>thành phố trực thuộc tỉnh<span style=\"color: #252525;\"> </span>Quảng Bình<span style=\"color: #252525;\"> ở vùng </span>Bắc Trung Bộ<span style=\"color: #252525;\"> </span>Việt Nam<span style=\"color: #252525;\">. Thành phố này nằm giữa </span>quốc lộ 1A<span style=\"color: #252525;\"> và </span>đường Hồ Chí Minh<span style=\"color: #252525;\"> và bên tuyến </span>đường sắt Hà Nội - Thành phố Hồ Chí Minh<span style=\"color: #252525;\"> với</span>ga Đồng Hới<span style=\"color: #252525;\"> là một trong những ga chính, có sông Nhật Lệ chảy qua. Đây là tỉnh lỵ tỉnh Quảng Bình. Đồng Hới giáp với </span>Biển Đông<span style=\"color: #252525;\"> ở phía đông với 12 km bờ biển cát trắng</span><sup id=\"cite_ref-5\" class=\"reference\" style=\"color: #252525;\">[5]</sup><span style=\"color: #252525;\">, huyện </span>Bố Trạch<span style=\"color: #252525;\"> ở phía tây và phía bắc, giáp huyện</span>Quảng Ninh<span style=\"color: #252525;\">, </span>di sản thiên nhiên thế giới<span style=\"color: #252525;\"> </span>vườn quốc gia Phong Nha-Kẻ Bàng<span style=\"color: #252525;\"> cách Đồng Hới 50 km về phía tây bắc. Đồng Hới đã từng là nơi </span>chúa Nguyễn<span style=\"color: #252525;\"> xây </span>thành Đồng Hới<span style=\"color: #252525;\">, </span>lũy Thầy<span style=\"color: #252525;\"> để làm tiền tuyến chống đỡ </span>Đàng Trong<span style=\"color: #252525;\"> trong thời kỳ </span>chiến tranh Trịnh-Nguyễn<span style=\"color: #252525;\">. Trong thời kỳ </span>chiến tranh Việt Nam<span style=\"color: #252525;\"> bị </span>không lực Hoa Kỳ<span style=\"color: #252525;\"> san phẳng và sau chiến tranh thị xã được xây dựng lại. Trước năm 1976, đây là tỉnh lỵ tỉnh Quảng Bình, từ năm 1976-1989, thị xã này thuộc tỉnh </span>Bình Trị Thiên<span style=\"color: #252525;\">. Tháng 7 năm 1989, ba tỉnh Quảng Bình, Quảng Trị Thừa Thiên được tách ra, thị xã này là tỉnh lỵ tỉnh Quảng Bình. Ngày 16 tháng 8 năm </span>2004<span style=\"color: #252525;\">, </span>Thủ tướng<span style=\"color: #252525;\"> </span>Chính phủ<span style=\"color: #252525;\"> đã có quyết định thành lập thành phố Đồng Hới trên cơ sở thị xã Đồng Hới</span><sup id=\"cite_ref-Donghoi_2-1\" class=\"reference\" style=\"color: #252525;\">[2]</sup><span style=\"color: #252525;\">.</span>\";s:10:\"post_title\";s:13:\"Đồng Hới\";s:12:\"post_excerpt\";s:0:\"\";s:11:\"post_status\";s:7:\"publish\";s:14:\"comment_status\";s:6:\"closed\";s:11:\"ping_status\";s:6:\"closed\";s:13:\"post_password\";s:0:\"\";s:9:\"post_name\";s:8:\"dong-hoi\";s:7:\"to_ping\";s:0:\"\";s:6:\"pinged\";s:0:\"\";s:13:\"post_modified\";s:19:\"2014-05-21 14:52:58\";s:17:\"post_modified_gmt\";s:19:\"2014-05-21 14:52:58\";s:21:\"post_content_filtered\";s:0:\"\";s:11:\"post_parent\";i:0;s:4:\"guid\";s:71:\"http://localhost/wp-cms/vietaustravel.au/?post_type=location&#038;p=536\";s:10:\"menu_order\";i:0;s:9:\"post_type\";s:8:\"location\";s:14:\"post_mime_type\";s:0:\"\";s:13:\"comment_count\";s:1:\"0\";s:6:\"filter\";s:3:\"raw\";}i:6;O:7:\"WP_Post\":24:{s:2:\"ID\";i:507;s:11:\"post_author\";s:1:\"1\";s:9:\"post_date\";s:19:\"2013-11-28 20:05:41\";s:13:\"post_date_gmt\";s:19:\"2013-11-28 20:05:41\";s:12:\"post_content\";s:0:\"\";s:10:\"post_title\";s:6:\"SAIGON\";s:12:\"post_excerpt\";s:0:\"\";s:11:\"post_status\";s:7:\"publish\";s:14:\"comment_status\";s:6:\"closed\";s:11:\"ping_status\";s:6:\"closed\";s:13:\"post_password\";s:0:\"\";s:9:\"post_name\";s:7:\"sai-gon\";s:7:\"to_ping\";s:0:\"\";s:6:\"pinged\";s:0:\"\";s:13:\"post_modified\";s:19:\"2014-05-29 15:51:50\";s:17:\"post_modified_gmt\";s:19:\"2014-05-29 15:51:50\";s:21:\"post_content_filtered\";s:0:\"\";s:11:\"post_parent\";i:0;s:4:\"guid\";s:85:\"http://www.kajag.com/themes/book_your_travel_wordpress/?post_type=location&#038;p=507\";s:10:\"menu_order\";i:0;s:9:\"post_type\";s:8:\"location\";s:14:\"post_mime_type\";s:0:\"\";s:13:\"comment_count\";s:1:\"0\";s:6:\"filter\";s:3:\"raw\";}i:7;O:7:\"WP_Post\":24:{s:2:\"ID\";i:223;s:11:\"post_author\";s:1:\"1\";s:9:\"post_date\";s:19:\"2013-09-16 09:14:27\";s:13:\"post_date_gmt\";s:19:\"2013-09-16 09:14:27\";s:12:\"post_content\";s:322:\"Dubrovnik is a city on the Adriat